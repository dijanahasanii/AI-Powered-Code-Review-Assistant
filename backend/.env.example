# =============================================
# AI Code Review Assistant - Environment Config
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Server ---
PORT=3001
NODE_ENV=development
# Production: validateProductionEnv.js enforces JWT, Supabase, GitHub, FRONTEND_URL,
# BACKEND_URL (HTTPS), TOKEN_ENCRYPTION_KEY_CURRENT, QUEUE_DRIVER=redis, REDIS_URL, cookies.

# --- JWT session (httpOnly cookie; ≥16 chars for login; 32+ random bytes in production) ---
JWT_SECRET=your_very_long_random_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# --- GitHub token encryption at rest (AES-256-GCM) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# New tokens always encrypt with CURRENT. Set PREVIOUS during key rotation only.
TOKEN_ENCRYPTION_KEY_CURRENT=
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Legacy alias (optional): maps to CURRENT if TOKEN_ENCRYPTION_KEY_CURRENT is unset
# TOKEN_ENCRYPTION_KEY=

# --- Database (Supabase — backend-only service role; never VITE_* / browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Optional: direct Postgres URL for SQL clients / backups only — the Node app does not read this today.
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Code review analyzer ---
# Built-in only: pattern heuristics on git diffs — no API keys or paid AI services required.

# --- GitHub OAuth App ---
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret_random_string

# Public base URL GitHub calls for webhooks (NO trailing slash). Local dev MUST use a tunnel (ngrok, Cloudflare Tunnel) — GitHub cannot reach localhost.
# Production: must be HTTPS and must not use localhost (validated at startup).
BACKEND_URL=https://YOUR-NGROK-SUBDOMAIN.ngrok.io

# --- URL / CORS (must match SPA Origin header exactly, scheme included) ---
# • Comma-separated allowed browser origins for REST + Socket.IO CORS (credentials: true):
#     FRONTEND_URL=https://app.example.com
# • Same origin as BACKEND_URL → session cookie SameSite=lax; different origins → SameSite=none (HTTPS required).
FRONTEND_URL=http://localhost:5173
# Optional (development only): extra SPA origins — ignored when NODE_ENV=production
# FRONTEND_DEV_EXTRA_ORIGINS=http://mydevbox.local:5173,http://192.168.1.50:5173

# --- Review job queue ---
# Local dev: omit QUEUE_DRIVER (in-process, no Redis). Production: QUEUE_DRIVER=redis (required).
# Enable Redis persistence (appendonly yes or save snapshots) so jobs survive restarts — see README §11.
# QUEUE_DRIVER=redis
REDIS_URL=redis://localhost:6379

# REQUIRED (process exits at boot if missing — see database.js):
# SUPABASE_URL, SUPABASE_SERVICE_KEY

# --- Remediation (Apply fixes → push to GitHub) ---
# strict = block push if npm run lint/build/test fails (production default)
# warn   = log validation failures but still push (development default)
# off    = skip npm validation entirely
# REMEDIATION_VALIDATION=warn

# --- Rate Limiting (optional; omit to use code defaults) ---
# Production (NODE_ENV=production): 100 requests / 15 min unless you set these.
# Development: 10 000 requests / 30 min unless overridden.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
