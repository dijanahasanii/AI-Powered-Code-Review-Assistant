# =============================================
# AI Code Review Assistant - Environment Config
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Server ---
PORT=3001
NODE_ENV=development
# Production: set NODE_ENV=production — the server runs validateProductionEnv.js at boot (JWT length, HTTPS Supabase URL, GitHub + webhook secrets, FRONTEND_URL).

# --- JWT Authentication (≥16 chars required for login; use 32+ random bytes in production) ---
JWT_SECRET=your_very_long_random_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# --- Database (Supabase — required; the API uses @supabase/supabase-js, not a raw PG driver) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Optional: direct Postgres URL for SQL clients / backups only — the Node app does not read this today.
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Code review analyzer ---
# Built-in only: pattern heuristics on git diffs — no API keys or paid AI services required.

# --- GitHub OAuth App ---
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret_random_string

# Public base URL GitHub calls for webhooks (NO trailing slash). Local dev MUST use a tunnel (ngrok, Cloudflare Tunnel) — GitHub cannot reach localhost.
BACKEND_URL=https://YOUR-NGROK-SUBDOMAIN.ngrok.io

# --- URL / CORS (must match SPA Origin header exactly, scheme included) ---
# • Comma-separated allowed browser origins for REST + Socket.IO CORS:
#     FRONTEND_URL=https://app.example.com
# • Trailing slashes on origins are tolerated (normalized to Origin).
# • Production: only origins listed in FRONTEND_URL are accepted.
# • Non-production: loopback (localhost, 127.0.0.1, ::1), private LAN IPv4 (10/8, 172.16–31/12, 192.168/16),
#   plus optional FRONTEND_DEV_EXTRA_ORIGINS (comma-separated). Default FRONTEND_URL still applies for OAuth primary URL.
FRONTEND_URL=http://localhost:5173
# Optional (development only): extra SPA origins, e.g. http://mydevbox.local:5173 — ignored when NODE_ENV=production
# FRONTEND_DEV_EXTRA_ORIGINS=http://mydevbox.local:5173,http://192.168.1.50:5173

# --- Review job queue ---
# Default: in-process (no Redis). For Bull + Redis set:
#   QUEUE_DRIVER=redis
REDIS_URL=redis://localhost:6379

# REQUIRED (process exits at boot if missing — see database.js):
# SUPABASE_URL, SUPABASE_SERVICE_KEY

# --- Rate Limiting (optional; omit to use code defaults) ---
# Production (NODE_ENV=production): 100 requests / 15 min unless you set these.
# Development: 10 000 requests / 30 min unless overridden.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
