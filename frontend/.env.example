# Frontend Environment Variables
# Copy to .env.local or .env and fill in values (never commit secrets).
#
# ── Typical local dev ──
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
# Optional: login uses GET {VITE_API_URL}/api/auth/github (server OAuth + signed state). Same id as backend GITHUB_CLIENT_ID if set.
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id

# ── Production shapes (must align with HTTPS / reverse proxy / GitHub OAuth) ──
# • Values are baked in at build time (`npm run build`).
# • Use ABSOLUTE origin only, NO trailing slash: https://api.example.com
# • If SPA and API share one reverse proxy (/api → Express, /socket.io → Socket.IO): leave both
#   VITE_* empty so the SPA uses window.location.origin (see src/config/publicUrls.js).
# • If SPA is HTTPS, set VITE_* to HTTPS too — mixed HTTP API from an HTTPS page is blocked by the browser.
# • WebSocket follows the Socket.IO URL scheme: https frontend + same-origin ⇒ wss upgrade via proxy.
